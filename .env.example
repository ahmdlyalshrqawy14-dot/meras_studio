# ==============================================================================
# MERAS STUDIO - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate your personal API keys/tokens.
# Never commit the actual .env file into Git!
# ==============================================================================

# Microsoft Azure Cognitive Services Speech
# Used by engine/voice_engine.py for cloud TTS synthesis.
# If omitted, engine gracefully uses high-quality Neural Edge Andrew voice.
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# Google Gemini API (Optional)
# Used for automated episode script expansion and ideation.
GEMINI_API_KEY=your_gemini_api_key_here

# YouTube Data API v3 (Optional)
# Used for automated publishing of episodes and shorts.
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json

# Telegram Notification Webhook (Optional)
# Used for real-time build & render completion notifications.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
